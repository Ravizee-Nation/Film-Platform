# Copy to .env for local development. Never commit .env.

# --- API (validated at startup; see packages/domain/src/env.ts) ---
APP_ENV=local
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgres://film:film@localhost:5432/film
# Integration tests create throwaway databases through this admin connection.
TEST_DATABASE_URL=postgres://film:film@localhost:5432/postgres
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=info
MIN_CLIENT_VERSION=0.1.0

# --- Web (server-side only) ---
API_URL=http://localhost:4000

# --- Mobile (public: inlined into the app bundle) ---
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

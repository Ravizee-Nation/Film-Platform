# Copy to .env for local development. Never commit .env.

# --- API (validated at startup; see packages/domain/src/env.ts) ---
APP_ENV=local
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgres://film:film@localhost:5432/film
# Integration tests create throwaway databases through this admin connection.
TEST_DATABASE_URL=postgres://film:film@localhost:5432/postgres
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=info
MIN_CLIENT_VERSION=0.1.0
# D7 trial (branch poc/d7-better-auth only). Local development value, never reused
# anywhere else. The API refuses to start until you replace this placeholder:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
AUTH_BASE_URL=http://localhost:4000
# Optional: write auth emails (verification, reset links) to this file instead of the log.
# AUTH_TEST_OUTBOX_FILE=./auth-outbox.jsonl

# --- Web (server-side only) ---
API_URL=http://localhost:4000
# Public, used by the browser auth client in the D7 trial page (/poc/auth).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Mobile ---
# Build variant for app.config.ts: development (default), staging or production.
# Separate from APP_ENV above, which belongs to the API and uses different values.
# APP_VARIANT=development
# Public, inlined into the app bundle:
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

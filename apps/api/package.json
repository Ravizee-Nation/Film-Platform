{
  "name": "@film/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.3",
    "@film/db": "workspace:*",
    "@film/domain": "workspace:*",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@film/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
